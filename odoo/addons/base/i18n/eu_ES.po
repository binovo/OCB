"\n"
"    \"ESG\": {\"private\": \"foundation\", \"public\": False, \"foreigner\": False},\n"
"\n"
"    \"ESH\": {\"private\": \"foundation\", \"public\": False, \"foreigner\": False},\n"
"\n"
"    \"ESJ\": {\"private\": \"other\", \"public\": False, \"foreigner\": False},\n"
"\n"
"    \"ESN\": {\"private\": \"other\", \"public\": False, \"foreigner\": False},\n"
"\n"
"    \"ESR\": {\"private\": \"other\", \"public\": False, \"foreigner\": False},\n"
"\n"
"    \"ESV\": {\"private\": \"other\", \"public\": False, \"foreigner\": False},\n"
"\n"
"    \"ESP\": {\"private\": False, \"public\": \"local_entity\", \"foreigner\": False},\n"
"\n"
"    \"ESQ\": {\"private\": False, \"public\": \"public_entity\", \"foreigner\": False},\n"
"\n"
"    \"ESS\": {\"private\": False, \"public\": \"autonomous_entity\", \"foreigner\": False},\n"
