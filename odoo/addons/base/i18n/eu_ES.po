#: model:ir.module.module,description:base.module_onchange_helper
msgid ""
"===============\n"
"Onchange Helper\n"
"===============\n"
"\n"
".. \n"
"   !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\n"
"   !! This file is generated by oca-gen-addon-readme !!\n"
