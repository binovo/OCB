#: model:ir.module.module,description:base.module_stock_picking_volume
msgid ""
"====================\n"
"Stock Picking Volume\n"
"====================\n"
"\n"
".. \n"
"   !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\n"
"   !! This file is generated by oca-gen-addon-readme !!\n"
"   !! changes will be overwritten.                   !!\n"
