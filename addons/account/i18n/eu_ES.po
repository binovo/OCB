"            <span style=\"font-weight:bold;\" t-out=\"object.name or ''\">RINV/2021/05/0001</span> faktura zuzentzailea\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            faktura zuzentzailea\n"
"        </t>\n"
"        <t t-if=\"object.invoice_origin\">\n"
"            (erreferentzia: <t t-out=\"object.invoice_origin or ''\">SUB003</t>)\n"
"        </t>\n"
"        <span style=\"font-weight:bold;\" t-out=\"format_amount(object.amount_total, object.currency_id) or ''\">143.750,00 €</span>-koa\n"
"        <t t-out=\"object.company_id.name or ''\">SuCompañía</t> enpresarena.\n"
