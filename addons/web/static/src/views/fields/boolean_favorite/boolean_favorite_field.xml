<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.BooleanFavoriteField" owl="1">
        <div class="o_favorite" t-on-click.prevent.stop="() => props.update(!props.value)">
            <a href="#" t-if="props.value">
                <i class="fa fa-star" role="img"
                   title="Remove from Favorites"
                   aria-label="Remove from Favorites"/>
                <span t-if="!props.noLabel">
                    Remove from Favorites
                </span>
            </a>
            <a href="#" t-else="">
                <i class="fa fa-star-o" role="img"
                   title="Add to Favorites"
                   aria-label="Add to Favorites"/>
                <span t-if="!props.noLabel">
                    Add to Favorites
                </span>
            </a>
        </div>
    </t>

</templates>
