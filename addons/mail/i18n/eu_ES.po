"<div class=\"o_mail_notification\">created <a href=\"#\" "
"class=\"o_channel_redirect\" data-oe-id=\"%s\">#%s</a></div>"
msgstr ""
"<div class=\"o_mail_notification\">erabiltzaileak <a href=\"#\" class=\"o_channel_redirect\" data-oe-id=\"%s\">#%s sortu du</a></div>"

