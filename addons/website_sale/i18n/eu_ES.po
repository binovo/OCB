-left-width:0px;border-bottom-width:0px;border-right-width:0px;border-top-width:0px;\">\n                                        <t t-out=\"int(line.product_uom_qty) or ''\">10.000</t> <t t-out=\"line.product_uom.name or ''\">Ale</t>\n                                    </td>\n                                </tr>\n                            </tbody></table>\n                        </t>\n                        <hr style=\"border-left-width:0px;border-bottom-width:0px;border-right-width:0px;border-top-width:0px;margin: 12px 0px; box-sizing: border-box; height: 1px; opacity: 0.25; border-width: 0px; background-color: currentcolor; color: #454748;border-style:none;\">\n                    </t>\n                    <div style=\"text-align: center; padding: 16px 0px 16px 0px; font-size: 14px;\">\n                        <a t-attf-href=\"{{ object.get_base_url() }}/shop/cart?access_token={{ object.access_token }}\" target=\"_blank\" style=\"box-sizing:border-box;background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;\">\n                            Jarraitu eskaerarekin\n                        </a>\n                    </div>\n                    <t t-set=\"company\" t-value=\"object.company_id or object.user_id.company_id or user.company_id\"></t>\n                    <div style=\"text-align: center;\"><strong style=\"box-sizing:border-box;font-weight:bolder;\">Eskerrik asko <t t-out=\"company.name or ''\">Nire Enpresari (San Frantzisko) erosteagatik</t>!</strong></div>\n                </td></tr>\n            </tbody></table>\n        </td>\n    </tr>\n</tbody>\n</table>\n            "

